#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D sourceImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform BlurSettings {
    int radius;
} settings;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 dimensions = imageSize(sourceImage);
    if (any(greaterThanEqual(pixel, dimensions))) {
        return;
    }

    const int radius = max(settings.radius, 0);
    vec4 accumulated = vec4(0.0);
    int sampleCount = 0;

    for (int y = -radius; y <= radius; ++y) {
        for (int x = -radius; x <= radius; ++x) {
            const ivec2 samplePixel =
                clamp(pixel + ivec2(x, y), ivec2(0), dimensions - ivec2(1));
            accumulated += imageLoad(sourceImage, samplePixel);
            ++sampleCount;
        }
    }

    imageStore(outputImage, pixel, accumulated / float(sampleCount));
}
